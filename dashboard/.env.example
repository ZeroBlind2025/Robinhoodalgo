# Copy to .env.local and fill in your values. Vite inlines anything
# prefixed with VITE_ at build time — these become baked into the
# production bundle, so treat VITE_API_TOKEN as public if you deploy
# the dashboard on an open URL. For private use, lock down the token
# scope on the engine side via DASHBOARD_ORIGIN.

# Base URL of the Python engine's /status server
VITE_API_URL=http://localhost:8000

# Bearer token matching DASHBOARD_TOKEN on the engine. Leave empty if
# the engine is running without auth (local dev only).
VITE_API_TOKEN=
